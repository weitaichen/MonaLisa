{
  "name": "meiyan-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/fetch-assets.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/fetch-assets.mjs && node scripts/gen-luts.mjs && node scripts/gen-makeup.mjs && node scripts/gen-icons.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "preact": "10.29.8",
    "@mediapipe/tasks-vision": "0.10.35"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/pngjs": "6.0.5",
    "fake-indexeddb": "6.2.5",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
